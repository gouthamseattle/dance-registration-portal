# Dance Registration Portal configuration
# Copy this file to .env for local development: cp .env.example .env
# Production values live in the Railway dashboard (Variables tab), never in git.

# --- Server ---
PORT=3000
# Leave as development locally. Production must be "production".
NODE_ENV=development

# Random string used to sign admin login cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change_me

# --- Database ---
# Local: leave DATABASE_URL unset and the app uses a SQLite file at DATABASE_PATH.
# Production: Railway sets DATABASE_URL (Postgres). If DATABASE_URL is set, Postgres is used.
DATABASE_PATH=./database/registrations.db
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Password for the "admin" login created by `npm run setup` (defaults to admin123)
ADMIN_PASSWORD=admin123

# --- Email (Gmail SMTP via nodemailer) ---
# Leave blank locally: the app still works, emails just aren't sent.
# Use a Gmail "app password", not your normal Gmail password.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Optional
# REPLY_TO=you@example.com
# EMAIL_FROM_NAME=Dance Class Registration
# EMAIL_DEBUG=true
